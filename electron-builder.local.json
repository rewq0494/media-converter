{
  "extends": null,
  "appId": "com.tools.media-converter",
  "productName": "Media Converter",
  "directories": {
    "output": "dist/local"
  },
  "files": [
    "main.js",
    "preload.js",
    "src/**",
    "renderer/**",
    "assets/icon.icns",
    "!node_modules/**/*"
  ],
  "extraMetadata": {
    "localMediaTools": true
  },
  "electronLanguages": [
    "en"
  ],
  "mac": {
    "category": "public.app-category.utilities",
    "icon": "assets/icon.icns",
    "identity": "-",
    "target": [
      {
        "target": "dir",
        "arch": [
          "arm64"
        ]
      }
    ],
    "hardenedRuntime": false
  }
}
